{
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.claude/harness-logs/**)",
      "Write(.claude/harness-logs/**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(*)",
      "mcp__UnityMCP__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:/Users/psh/.claude/sounds/play.ps1"
          }
        ]
      }
    ]
  }
}
